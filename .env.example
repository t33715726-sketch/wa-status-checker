# ------------------------------------------------------------
# אין כאן סודות אמיתיים. העתק ל-.env לפיתוח מקומי.
# ב-Railway מגדירים את אותם מפתחות במסך Variables.
# ------------------------------------------------------------

NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# Railway עומד מאחורי פרוקסי אחד
TRUST_PROXY=1

# --- מחזור חיי סשן (מילישניות) ---
SESSION_IDLE_TTL_MS=600000
SESSION_HARD_TTL_MS=1200000
MAX_CONCURRENT_SESSIONS=40
QR_WAIT_MS=180000

# --- סנכרון ---
# היסטוריה מלאה = איטי ויקר בזיכרון. השאר false אלא אם חובה.
WA_FULL_HISTORY=false
SYNC_TIMEOUT_MS=90000
SYNC_QUIET_MS=9000
SYNC_MIN_MS=6000

# --- הגבלות קצב ---
START_WINDOW_MS=900000
START_MAX=12
API_WINDOW_MS=60000
API_MAX=60
MAX_EXPORT=3000

# --- טלמטריה אנונימית (אופציונלי, ספירות בלבד) ---
STATS_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STATS_TABLE=scan_events
